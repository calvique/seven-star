NODE_ENV=production
PORT=10000
API_URL=https://YOUR-API.onrender.com
FRONTEND_URL=https://YOUR-WEB.onrender.com
FRONTEND_URLS=https://YOUR-WEB.onrender.com

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/sevenstar-school?retryWrites=true&w=majority

JWT_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_REFRESH_EXPIRES_IN=30d

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=School Administrator
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
